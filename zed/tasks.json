// OpenCode Collab — Zed tasks.
//
// Copy this into your global tasks (`zed: open tasks`) or a project `.zed/tasks.json`.
// The session picker is a task because a language server cannot render a list picker;
// it runs in Zed's integrated terminal, lists OpenCode sessions for the current
// worktree, and pins the one you choose (sends from this worktree then target it).
//
// Adjust the absolute path below to wherever you installed this repo.
[
  {
    "label": "OpenCode: switch session",
    "command": "node /Users/anirudh/workspace/zed-opencode/lsp/dist/cli.js pick \"$ZED_WORKTREE_ROOT\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success"
  }
]
